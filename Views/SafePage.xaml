<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIDemo.Views.SafePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="18" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- ============ 页头 ============ -->
            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="Safe" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="防火墙、防病毒、激活与注册表权限，全部真实生效" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <!-- ============ 系统与权限 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,6">
                <StackPanel>
                    <Grid Margin="0,14,0,10">
                        <TextBlock Text="系统与权限" Style="{StaticResource SectionTitleStyle}" />
                    </Grid>

                    <!-- 关闭防火墙：专用 + 公用一起关，落 HKLM，改一次提一次权 -->
                    <Grid Margin="0,0,0,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="关闭防火墙" FontSize="13.5" />
                            <TextBlock Text="专用网络 + 公用网络一起关 / 开" Style="{StaticResource MetaStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FirewallToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                      VerticalAlignment="Center" Toggled="Firewall_Toggled" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,10" />

                    <!-- 关闭防病毒：组策略「关闭 Microsoft Defender 防病毒」 -->
                    <Grid Margin="0,0,0,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="关闭防病毒" FontSize="13.5" />
                            <TextBlock Text="组策略「关闭 Microsoft Defender 防病毒」，重启后生效" Style="{StaticResource MetaStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DefenderToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                      VerticalAlignment="Center" Toggled="Defender_Toggled" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,10" />

                    <!-- 关闭防病毒(注册表)：直接往 Defender 策略键里写一整组值 -->
                    <Grid Margin="0,0,0,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="关闭防病毒(注册表)" FontSize="13.5" />
                            <TextBlock Text="不开组策略界面，直接写 6 个 Defender 策略值" Style="{StaticResource MetaStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DefenderRegistryToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                      VerticalAlignment="Center" Toggled="DefenderRegistry_Toggled" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,10" />

                    <!-- 系统激活：只读检测 + 一键 KMS -->
                    <Grid Margin="0,0,0,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="系统激活" FontSize="13.5" />
                            <TextBlock Text="管理员 PowerShell 依次执行 4 条 slmgr 命令" Style="{StaticResource MetaStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivationText" Text="检测中…" FontSize="12.5" VerticalAlignment="Center" />
                            <Button x:Name="ActivateButton" Content="KMS 激活" CornerRadius="8" Click="Activate_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,10" />

                    <!-- 注册表键权限：完全控制 + 所有者（含子键） -->
                    <Grid Margin="0,0,0,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="注册表权限" FontSize="13.5" />
                            <TextBlock Text="给当前用户完全控制 + 所有者（含子键），之后防火墙通知才能改" Style="{StaticResource MetaStyle}" />
                        </StackPanel>
                        <Button x:Name="GrantAclButton" Grid.Column="1" Content="添加权限" CornerRadius="8"
                                VerticalAlignment="Center" Click="GrantAcl_Click" />
                    </Grid>

                    <!-- 防火墙通知：wscsvc 的 Start（2 开启 / 4 关闭），只有上面那个键有权限时才显示 -->
                    <StackPanel x:Name="FirewallNotifySection" Visibility="Collapsed">
                        <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="防火墙通知" FontSize="13.5" />
                                <TextBlock Text="安全中心服务的启动类型" Style="{StaticResource MetaStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FirewallNotifyToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                          VerticalAlignment="Center" Toggled="FirewallNotify_Toggled" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 安全中心设置 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,6">
                <StackPanel>
                    <Grid Margin="0,14,0,10">
                        <TextBlock Text="安全中心设置" Style="{StaticResource SectionTitleStyle}" />
                    </Grid>

                    <!-- 一键关闭：注册表 + Set-MpPreference，重启项会标出来 -->
                    <Grid Margin="0,0,0,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="关闭全部防护" FontSize="13.5" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SecurityCenterToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                      VerticalAlignment="Center" Toggled="SecurityCenter_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>