<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtkTools.Views.SafePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- 说明文字改成悬停提示：悬停 140ms 弹出；透明背景让整行（含空白处和标签）都能命中鼠标 -->
        <Style x:Key="SafeRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="16">
            <!-- ============ 页头 ============ -->
            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="Safe" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="防火墙、防病毒、激活与注册表权限，全部真实生效" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- ============ 防火墙与防病毒 ============ -->
                <Border Style="{StaticResource CardStyle}" Padding="20,6">
                    <StackPanel>
                        <Grid Margin="0,14,0,10">
                            <TextBlock Text="防火墙与防病毒" Style="{StaticResource SectionTitleStyle}" />
                        </Grid>

                        <!-- 关闭防火墙：专用 + 公用一起关，落 HKLM，改一次提一次权 -->
                        <Grid Style="{StaticResource SafeRow}" PointerMoved="Row_PointerMoved" PointerExited="Row_PointerExited" ColumnSpacing="16"
                              Tag="专用网络 + 公用网络一起关 / 开">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="关闭防火墙" FontSize="13.5" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="FirewallToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                          VerticalAlignment="Center" Toggled="Firewall_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,10" />

                        <!-- 关闭防病毒：组策略「关闭 Microsoft Defender 防病毒」 -->
                        <Grid Style="{StaticResource SafeRow}" PointerMoved="Row_PointerMoved" PointerExited="Row_PointerExited" ColumnSpacing="16"
                              Tag="组策略「关闭 Microsoft Defender 防病毒」，重启后生效">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="关闭防病毒" FontSize="13.5" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="DefenderToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                          VerticalAlignment="Center" Toggled="Defender_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,10" />

                        <!-- 关闭防病毒(注册表)：直接往 Defender 策略键里写一整组值 -->
                        <Grid Style="{StaticResource SafeRow}" PointerMoved="Row_PointerMoved" PointerExited="Row_PointerExited" ColumnSpacing="16"
                              Tag="不开组策略界面，直接写 6 个 Defender 策略值">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="关闭防病毒(注册表)" FontSize="13.5" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="DefenderRegistryToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                          VerticalAlignment="Center" Toggled="DefenderRegistry_Toggled" />
                        </Grid>

                        <!-- 防火墙通知：wscsvc 的 Start（2 开启 / 4 关闭），只有上面那个键有权限时才显示 -->
                        <StackPanel x:Name="FirewallNotifySection" Visibility="Collapsed">
                            <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,6,0,10" />

                            <Grid Style="{StaticResource SafeRow}" PointerMoved="Row_PointerMoved" PointerExited="Row_PointerExited" Margin="0,0,0,14" ColumnSpacing="16"
                                  Tag="安全中心服务的启动类型">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="防火墙通知" FontSize="13.5" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="FirewallNotifyToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                              VerticalAlignment="Center" Toggled="FirewallNotify_Toggled" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 右列：安全中心 + 系统与权限 ============ -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="20,6">
                        <StackPanel>
                            <Grid Margin="0,14,0,10">
                                <TextBlock Text="安全中心设置" Style="{StaticResource SectionTitleStyle}" />
                            </Grid>

                            <!-- 一键关闭：注册表 + Set-MpPreference，重启项会标出来 -->
                            <Grid Style="{StaticResource SafeRow}" PointerMoved="Row_PointerMoved" PointerExited="Row_PointerExited" Margin="0,0,0,14" ColumnSpacing="16"
                                  Tag="一键关闭 Defender 实时防护与相关服务">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关闭全部防护" FontSize="13.5" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="SecurityCenterToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                              VerticalAlignment="Center" Toggled="SecurityCenter_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20,6">
                        <StackPanel>
                            <Grid Margin="0,14,0,10">
                                <TextBlock Text="系统与权限" Style="{StaticResource SectionTitleStyle}" />
                            </Grid>

                            <!-- 系统激活：只读检测 + 一键 KMS -->
                            <Grid Style="{StaticResource SafeRow}" PointerMoved="Row_PointerMoved" PointerExited="Row_PointerExited" ColumnSpacing="16"
                                  Tag="管理员 PowerShell 依次执行 4 条 slmgr 命令">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="系统激活" FontSize="13.5" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActivationText" Text="检测中…" FontSize="12.5" VerticalAlignment="Center" />
                                    <Button x:Name="ActivateButton" Content="KMS 激活" CornerRadius="8" Click="Activate_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource GridLineBrush}" Margin="0,10" />

                            <!-- 注册表键权限：完全控制 + 所有者（含子键） -->
                            <Grid Style="{StaticResource SafeRow}" PointerMoved="Row_PointerMoved" PointerExited="Row_PointerExited" Margin="0,0,0,14" ColumnSpacing="16"
                                  Tag="给当前用户完全控制 + 所有者（含子键），之后防火墙通知才能改">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="注册表权限" FontSize="13.5" VerticalAlignment="Center" />
                                <Button x:Name="GrantAclButton" Grid.Column="1" Content="添加权限" CornerRadius="8"
                                        VerticalAlignment="Center" Click="GrantAcl_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
