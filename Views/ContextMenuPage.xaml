<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtkTools.Views.ContextMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct="using:ArtkTools.Services.ComputerTools"
    xmlns:local="using:ArtkTools.Views"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">

    <Page.Resources>
        <DataTemplate x:Key="CmSectionHeaderTemplate" x:DataType="local:CmSectionHeader">
            <Grid Padding="14,14,14,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind Key}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="11.5"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CmItemTemplate" x:DataType="ct:ContextMenuEntry">
            <Border BorderBrush="{ThemeResource GridLineBrush}" BorderThickness="0,0,0,1">
                <Grid Padding="14,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 软件图标（解析不到时显示首字占位） -->
                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" />
                        <TextBlock Text="{x:Bind Initial}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image Source="{x:Bind IconDisplay, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform" />
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind DetailText}" Style="{StaticResource MetaStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent=""
                                  IsOn="{x:Bind Enabled, Mode=OneWay}"
                                  IsEnabled="{x:Bind CanToggle}"
                                  Toggled="MenuToggle_Toggled"
                                  VerticalAlignment="Center" />

                    <Button Grid.Column="3" Padding="10,6"
                            Visibility="{x:Bind DeleteVisibility}"
                            Click="MenuDelete_Click"
                            ToolTipService.ToolTip="删除该项">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <local:CmRowTemplateSelector x:Key="CmRowSelector"
                                     ItemTemplate="{StaticResource CmItemTemplate}"
                                     HeaderTemplate="{StaticResource CmSectionHeaderTemplate}" />
    </Page.Resources>

    <Grid Padding="36,18,40,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <Button Padding="0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Left" Click="Back_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    <TextBlock Text="电脑工具" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Text="右键菜单管理" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="按场景分类查看文件、文件夹、桌面等位置的右键菜单，默认只显示已识别来源的第三方菜单"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <CheckBox x:Name="AllModeCheck" Content="展示全部" Click="AllMode_Click"
                              ToolTipService.ToolTip="包含系统内置、未识别与命令仓库等技术项" />
                    <Button x:Name="MenuRefreshButton" Content="刷新"
                            Padding="12,6" Click="MenuRefresh_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 场景分类 -->
            <Border Style="{StaticResource CardStyle}" Padding="6" VerticalAlignment="Stretch">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="12,8,12,2" Spacing="1">
                        <TextBlock Text="场景分类" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="点选场景过滤右侧列表" Style="{StaticResource MetaStyle}" />
                    </StackPanel>

                    <ListView x:Name="SceneList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="SceneList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CmSceneNavItem">
                                <Grid Padding="8,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind Key}" FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Column="1" CornerRadius="8" Padding="7,0"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind CountText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 菜单项列表 -->
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBox x:Name="MenuSearch" PlaceholderText="搜索名称、来源软件或场景"
                             TextChanged="MenuSearch_TextChanged" />
                    <TextBlock x:Name="MenuStatusText" Style="{StaticResource MetaStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <ListView x:Name="MenuList" SelectionMode="None" VerticalAlignment="Stretch"
                                  ItemTemplateSelector="{StaticResource CmRowSelector}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock x:Name="MenuEmptyText" Margin="24,32,24,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Style="{StaticResource MetaStyle}" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
