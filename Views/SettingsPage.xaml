<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIDemo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- 说明文字 -->
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource MetaStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- 行与行之间的细线 -->
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource GridLineBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="18" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="外观、启动行为、软件安装位置与连接状态" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <!-- ============ 常规：外观 + 启动 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="主题" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="立即生效，不需要重启" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="160" SelectedIndex="0"
                                  VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="云母材质" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="关闭后窗口改用不透明背景，低配设备更省电" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MicaToggle" Grid.Column="1" IsOn="True"
                                      OnContent="开" OffContent="关" VerticalAlignment="Center"
                                      Toggled="MicaToggle_Toggled" />
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="启动时打开" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="下次启动应用时默认进入的模块" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="StartupCombo" Grid.Column="1" Width="160" SelectedIndex="0"
                                  VerticalAlignment="Center" SelectionChanged="StartupCombo_SelectionChanged">
                            <ComboBoxItem Content="Windows" />
                            <ComboBoxItem Content="软件" />
                            <ComboBoxItem Content="Game" />
                            <ComboBoxItem Content="Safe" />
                            <ComboBoxItem Content="手机工具" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 软件安装 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <TextBlock Text="软件安装" Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="安装位置" Style="{StaticResource RowTitleStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallDirBox" PlaceholderText="留空 = 各软件默认目录，例如 D:\Program Files\Apps"
                                 TextChanged="InstallDirBox_TextChanged" />
                        <Button Grid.Column="1" Content="浏览…" CornerRadius="8" Click="BrowseInstallDir_Click" />
                        <Button Grid.Column="2" Content="默认" CornerRadius="8" Click="ResetInstallDir_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 清单服务器（固定地址，只读） ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <TextBlock Text="清单服务器" Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="服务器地址" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock x:Name="ServerAddressText" Style="{StaticResource RowHintStyle}"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="检查连接" CornerRadius="8" Padding="14,5,14,5"
                                VerticalAlignment="Center" Click="CheckServer_Click" />
                    </Grid>

                    <TextBlock x:Name="ServerStatusText" Text="尚未检查" Style="{StaticResource MetaStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 关于 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Width="40" Height="40" VerticalAlignment="Center" Source="/Assets/ArtkTools.png" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Artk Tools" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource MetaStyle}" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="恢复默认设置" VerticalAlignment="Center" CornerRadius="8"
                                Click="Reset_Click" />
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />
                </StackPanel>
            </Border>

            <!-- ============ 卸载（仅安装版可用） ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <TextBlock Text="卸载" Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="卸载 Artk Tools" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock x:Name="UninstallHint" TextWrapping="Wrap" Style="{StaticResource RowHintStyle}"
                                   Text="从本机移除 Artk Tools 的安装文件与开始菜单 / 桌面快捷方式，并删除 %LOCALAPPDATA%\Nova 里的设置、清单缓存与下载记录。" />
                    </StackPanel>

                    <Button x:Name="UninstallButton" Content="卸载 Artk Tools" Click="Uninstall_Click"
                            HorizontalAlignment="Left" CornerRadius="8"
                            Background="{ThemeResource SystemFillColorCriticalBrush}" Foreground="White" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
