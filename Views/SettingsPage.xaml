<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIDemo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource MetaStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource GridLineBrush}" />
        </Style>

        <!-- 分组标题前的小色块 -->
        <Style x:Key="GroupIconStyle" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource IconTileBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GroupIconGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource BrandBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 安装位置只读展示：外框自己画圆角，路径文字用 TextBlock 垂直居中 -->
        <Style x:Key="FieldFrameStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
            <!-- ============ 页头 ============ -->
            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="外观、启动行为与软件安装位置 · 改动即时保存" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <!-- ============ 常规 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource GroupIconStyle}">
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource GroupIconGlyphStyle}" />
                        </Border>
                        <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="主题" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="立即生效，不需要重启" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="160" SelectedIndex="0"
                                  VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="云母材质" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="关闭后窗口改用不透明背景，低配设备更省电" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MicaToggle" Grid.Column="1" IsOn="True"
                                      OnContent="开" OffContent="关" VerticalAlignment="Center"
                                      Toggled="MicaToggle_Toggled" />
                    </Grid>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="启动时打开" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="下次启动应用时默认进入的模块" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="StartupCombo" Grid.Column="1" Width="160" SelectedIndex="0"
                                  VerticalAlignment="Center" SelectionChanged="StartupCombo_SelectionChanged">
                            <ComboBoxItem Content="Windows" />
                            <ComboBoxItem Content="垃圾清理" />
                            <ComboBoxItem Content="软件" />
                            <ComboBoxItem Content="Game" />
                            <ComboBoxItem Content="Safe" />
                            <ComboBoxItem Content="手机工具" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 软件安装 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource GroupIconStyle}">
                            <FontIcon Glyph="&#xE896;" Style="{StaticResource GroupIconGlyphStyle}" />
                        </Border>
                        <TextBlock Text="软件安装" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource FieldFrameStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="12" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="InstallDirText" Grid.Column="1" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="留空 = 各软件默认目录，例如 D:\Program Files\Apps" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Content="浏览…" CornerRadius="8" MinHeight="34" Padding="16,0"
                                Style="{StaticResource AccentButtonStyle}" Click="BrowseInstallDir_Click" />
                        <Button Grid.Column="2" Content="默认" CornerRadius="8" MinHeight="34" Padding="10,0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Click="ResetInstallDir_Click" />
                    </Grid>

                    <TextBlock Text="所有新下载的软件都装到这个目录；每款软件会在里面建自己的子文件夹。"
                               Style="{StaticResource RowHintStyle}" />
                </StackPanel>
            </Border>

            <!-- ============ 关于 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource GroupIconStyle}">
                            <FontIcon Glyph="&#xE946;" Style="{StaticResource GroupIconGlyphStyle}" />
                        </Border>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Width="40" Height="40" VerticalAlignment="Center" Source="/Assets/ArtkTools.png" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Artk Tools" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource MetaStyle}" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="恢复默认设置" VerticalAlignment="Center" CornerRadius="8"
                                Click="Reset_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 卸载（仅安装版可用） ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource GroupIconStyle}">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Foreground="{ThemeResource DangerBrush}" />
                        </Border>
                        <TextBlock Text="卸载" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="UninstallHint" TextWrapping="Wrap" Style="{StaticResource RowHintStyle}"
                               Text="从本机移除 Artk Tools 的安装文件与开始菜单 / 桌面快捷方式，并删除 %LOCALAPPDATA%\Nova 里的设置、清单缓存与下载记录。" />

                    <Button x:Name="UninstallButton" Content="卸载 Artk Tools" Click="Uninstall_Click"
                            HorizontalAlignment="Left" CornerRadius="8"
                            Background="{ThemeResource SystemFillColorCriticalBrush}" Foreground="White" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
