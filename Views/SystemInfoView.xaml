<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUIDemo.Views.SystemInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="20,6,20,18" Spacing="11">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="设备名称" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="DeviceNameText" Grid.Column="1" FontSize="12.5"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Grid>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="处理器" Style="{StaticResource MetaStyle}" VerticalAlignment="Top"
                       Margin="0,2,0,0" />
            <TextBlock x:Name="ProcessorText" Grid.Column="1" FontSize="12.5"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Grid>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="内存大小" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="MemoryText" Grid.Column="1" FontSize="12.5"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Grid>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="显卡" Style="{StaticResource MetaStyle}" VerticalAlignment="Top"
                       Margin="0,2,0,0" />
            <TextBlock x:Name="GraphicsText" Grid.Column="1" FontSize="12.5"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Grid>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="操作系统" Style="{StaticResource MetaStyle}" VerticalAlignment="Top"
                       Margin="0,2,0,0" />
            <TextBlock x:Name="OsText" Grid.Column="1" FontSize="12.5"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Grid>
    </StackPanel>
</UserControl>
