<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUIDemo.Views.AddSoftwareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 地址栏 ============ -->
        <Grid Padding="12,9" ColumnSpacing="6" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Click="Back_Click" IsEnabled="False"
                    Width="32" Height="32" Padding="0" CornerRadius="8" Background="Transparent"
                    BorderThickness="0" ToolTipService.ToolTip="后退">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <Button x:Name="ForwardButton" Grid.Column="1" Click="Forward_Click" IsEnabled="False"
                    Width="32" Height="32" Padding="0" CornerRadius="8" Background="Transparent"
                    BorderThickness="0" ToolTipService.ToolTip="前进">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>

            <Button Grid.Column="2" Click="Refresh_Click" Width="32" Height="32" Padding="0"
                    CornerRadius="8" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="刷新">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>

            <TextBox x:Name="AddressBox" Grid.Column="3" VerticalAlignment="Center"
                     PlaceholderText="输入网址，或直接输入关键词用必应搜索"
                     KeyDown="AddressBox_KeyDown" />

            <Button Grid.Column="4" Content="打开" CornerRadius="8" Padding="16,5,16,5"
                    VerticalAlignment="Center" Click="Go_Click" />

            <ProgressRing x:Name="LoadingRing" Grid.Column="5" Width="18" Height="18"
                          IsActive="False" VerticalAlignment="Center" Margin="6,0,4,0" />
        </Grid>

        <!-- ============ 浏览器 ============ -->
        <Grid Grid.Row="1">
            <WebView2 x:Name="Browser" />

            <!-- 启动中 / 启动失败时盖一层，避免一片空白 -->
            <Grid x:Name="StartOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="520">
                    <ProgressRing x:Name="StartRing" Width="30" Height="30" IsActive="True"
                                  HorizontalAlignment="Center" />
                    <TextBlock x:Name="StartText" Text="正在准备浏览器…"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="RuntimeButton" Content="安装 WebView2 运行时" Visibility="Collapsed"
                            HorizontalAlignment="Center" Click="Runtime_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ 底部提示 ============ -->
        <Border Grid.Row="2" Padding="14,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Text="在打开的网页里点厂商的「下载」按钮，就会自动抓取直链并弹出添加确认。"
                       Style="{StaticResource MetaStyle}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
