<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIDemo.Views.PhoneToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="32,18,36,28">
            <StackPanel Spacing="12">
                <!-- ============ 页头 ============ -->
                <StackPanel Spacing="4" Margin="0,0,0,2">
                    <TextBlock Text="手机工具" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="通过 adb / fastboot 读取已连接安卓设备的状态与信息" Style="{StaticResource CaptionStyle}" />
                </StackPanel>

                <!-- ============ 连接状态 ============ -->
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center"
                                Background="{ThemeResource IconTileBrush}">
                            <FontIcon Glyph="&#xE8EA;" FontSize="19"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="StateText" Text="正在检测…" FontSize="16.5"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SerialText" Text="设备序列号：—" Style="{StaticResource MetaStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ToolText" Text="" Style="{StaticResource MetaStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                            <Button x:Name="RefreshButton" Content="刷新" CornerRadius="8" Padding="14,5,14,5"
                                    Click="Refresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 主体：左（设备信息 + 快捷命令） / 右（电池、储存与内存） ============ -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <!-- 设备信息 -->
                        <Border Style="{StaticResource CardStyle}" Padding="20,16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="设备信息" Style="{StaticResource SectionTitleStyle}" />

                                <Grid ColumnSpacing="12" RowSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="设备名称" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="NameValue" Text="—" FontSize="14" TextWrapping="Wrap" />

                                    <TextBlock Grid.Column="2" Text="设备代号" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" x:Name="CodenameValue" Text="—" FontSize="14" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Text="安卓版本" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AndroidValue" Text="—" FontSize="14" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="BL 解锁" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="BlValue" Text="—" FontSize="14" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" Text="系统版本" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SystemValue" Text="—"
                                               FontSize="14" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Text="内核版本" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="KernelValue" Text="—" FontSize="14" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="A/B 分区" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" x:Name="AbValue" Text="—" FontSize="14" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="4" Text="SELinux" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SelinuxValue" Text="—"
                                               FontSize="14" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="5" Text="序列号" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SerialValue" Text="—"
                                               FontSize="14" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 快捷命令 -->
                        <Border Style="{StaticResource CardStyle}" Padding="20,16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="快捷命令" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="执行前会再确认一次，结果以右上角通知显示。"
                                           Style="{StaticResource MetaStyle}" TextWrapping="Wrap" />

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button x:Name="RebootButton" Content="重启系统" CornerRadius="8" Padding="12,7"
                                            HorizontalAlignment="Stretch" Tag="reboot" Click="Action_Click" />
                                    <Button x:Name="SoftRebootButton" Grid.Column="1" Content="软重启" CornerRadius="8" Padding="12,7"
                                            HorizontalAlignment="Stretch" Tag="soft" Click="Action_Click" />
                                    <Button x:Name="FastbootButton" Grid.Column="2" Content="进入 Fastboot" CornerRadius="8" Padding="12,7"
                                            HorizontalAlignment="Stretch" Tag="fastboot" Click="Action_Click" />

                                    <Button x:Name="InstallApkButton" Grid.Row="1" CornerRadius="8" Padding="12,7"
                                            HorizontalAlignment="Stretch" Click="InstallApk_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                                            <TextBlock Text="安装 APK" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="FastbootdButton" Grid.Row="1" Grid.Column="1" Content="进入 Fastbootd" CornerRadius="8"
                                            Padding="12,7" HorizontalAlignment="Stretch" Tag="fastbootd" Click="Action_Click" />

                                    <Button x:Name="ConsoleButton" Grid.Row="1" Grid.Column="2" CornerRadius="8"
                                            Padding="12,7" HorizontalAlignment="Stretch" Click="OpenConsole_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE756;" FontSize="13" />
                                            <TextBlock Text="CMD 命令行" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <!-- 电池（小卡片） -->
                        <Border Style="{StaticResource CardStyle}" Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="电池" Style="{StaticResource SectionTitleStyle}" />

                                <StackPanel Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="是否充电" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BatteryStatusValue" Text="—" FontSize="13.5" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="电量" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BatteryLevelValue" Text="—" FontSize="13.5" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="温度" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BatteryTempValue" Text="—" FontSize="13.5" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="电压" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BatteryVoltageValue" Text="—" FontSize="13.5" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="寿命" Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BatteryLifeValue" Text="—" FontSize="13.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 电池图标：外框 + 按电量填充 + 正极 -->
                                <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,2,0,0">
                                    <Border Width="46" Height="22" CornerRadius="5" BorderThickness="2" Padding="2"
                                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Grid>
                                            <Border x:Name="BatteryFill" Width="0" HorizontalAlignment="Left"
                                                    CornerRadius="2"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="4" Height="10" CornerRadius="0,2,2,0"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 储存与内存（小卡片，横向排列） -->
                        <Border Style="{StaticResource CardStyle}" Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="储存与内存" Style="{StaticResource SectionTitleStyle}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <Grid Width="52" Height="52" HorizontalAlignment="Center">
                                            <ProgressRing x:Name="MemoryRing" Width="52" Height="52"
                                                          IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                          Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <TextBlock x:Name="MemoryPercentText" Text="—" FontSize="11"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="内存" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource MetaStyle}"
                                                   FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                        <Grid Width="52" Height="52" HorizontalAlignment="Center">
                                            <ProgressRing x:Name="StorageRing" Width="52" Height="52"
                                                          IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                          Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <TextBlock x:Name="StoragePercentText" Text="—" FontSize="11"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="储存（/data）" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="StorageText" Text="—" Style="{StaticResource MetaStyle}"
                                                   FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="HintText" Style="{StaticResource MetaStyle}" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
