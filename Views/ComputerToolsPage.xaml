<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtkTools.Views.ComputerToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ArtkTools.Views"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">

    <Page.Resources>
        <DataTemplate x:Key="ToolCardTemplate" x:DataType="local:ComputerToolCard">
            <Button Style="{StaticResource TileButtonStyle}"
                    Height="152"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    Tag="{x:Bind Id}"
                    Click="Card_Click"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited"
                    PointerPressed="Card_PointerPressed"
                    PointerReleased="Card_PointerReleased">
                <Grid RowSpacing="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 图标 -->
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{ThemeResource IconTileBrush}"
                            HorizontalAlignment="Left">
                        <Grid>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="17"
                                      Foreground="{ThemeResource BrandBrush}"
                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}"
                                   Width="26" Height="26" Stretch="Uniform"
                                   Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{x:Bind Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2"
                               Text="{x:Bind Description}"
                               Style="{StaticResource CaptionStyle}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="打开工具" FontSize="12"
                                   Foreground="{ThemeResource BrandBrush}" />
                        <FontIcon Glyph="&#xE76C;" FontSize="9"
                                  Foreground="{ThemeResource BrandBrush}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="16">
            <!-- ============ 页头 ============ -->
            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="电脑工具" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="选择一个工具进入，所有检测都是只读的，需要改系统时才会请求管理员权限"
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ============ 工具卡片：按窗口宽度自动换列 ============ -->
            <ItemsRepeater ItemsSource="{x:Bind Cards}"
                           ItemTemplate="{StaticResource ToolCardTemplate}"
                           UseLayoutRounding="True"
                           ElementPrepared="Cards_Prepared">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200" MinItemHeight="152"
                                       MinRowSpacing="12" MinColumnSpacing="12"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
