<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArtkTools.Views.SystemSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        设置按用途分成四组，左右两列排布，组内不再用分隔线，靠间距区分层级。
        开关要写三样东西才能真的靠右：
          1. MinWidth="0" —— 默认样式带 154 DIP 最小宽度，不去掉控件就比开关本身宽一大截；
          2. OnContent="" / OffContent="" —— 不写的话模板会带上本地化的「开 / 关」文字，
             把开关顶到左边去；
          3. Margin="0,0,-12,0" —— 模板在开关列后面固定留了一列 12 DIP 的空列给文字，
             用负边距把这截吃掉，开关轨道才和下面的下拉框 / 按钮对齐。
    -->
    <Grid Padding="20,12,20,20" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左列 -->
        <StackPanel Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="输入与电源" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />

                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="关闭提高指针精度" FontSize="13.5" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="PointerPrecisionToggle" Grid.Column="1"
                                  MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Toggled="PointerPrecision_Toggled" />
                </Grid>

                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="高性能电源计划" FontSize="13.5" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="HighPerformanceToggle" Grid.Column="1"
                                  MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Toggled="HighPerformance_Toggled" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="外观与显示" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />

                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="桌面背景（图片）" FontSize="13.5" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="BackgroundToggle" Grid.Column="1"
                                  MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Toggled="Background_Toggled" />
                </Grid>

                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="深色模式" FontSize="13.5" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="DarkModeToggle" Grid.Column="1"
                                  MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Toggled="DarkMode_Toggled" />
                </Grid>

                <!-- 刷新率：选项来自 EnumDisplaySettings，选中即切换 -->
                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="刷新率" FontSize="13.5" VerticalAlignment="Center" />
                    <ComboBox x:Name="RefreshRateBox" Grid.Column="1" MinWidth="132"
                              DisplayMemberPath="Label"
                              SelectionChanged="RefreshRate_SelectionChanged" />
                </Grid>

                <!-- 右键菜单样式：Windows 10 经典完整菜单 / Windows 11 精简菜单 -->
                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="右键菜单样式" FontSize="13.5" VerticalAlignment="Center" />
                    <ComboBox x:Name="ContextMenuStyleBox" Grid.Column="1" MinWidth="132"
                              SelectionChanged="ContextMenuStyle_SelectionChanged">
                        <ComboBoxItem Content="Windows 10" />
                        <ComboBoxItem Content="Windows 11" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- 右列 -->
        <StackPanel Grid.Column="1" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="任务栏与桌面" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />

                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="任务栏图标靠左" FontSize="13.5" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="TaskbarLeftToggle" Grid.Column="1"
                                  MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Toggled="TaskbarLeft_Toggled" />
                </Grid>

                <!-- 桌面图标：一个下拉，里面五项可勾选，勾选时面板不关，能连着点多选 -->
                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="桌面图标" FontSize="13.5" VerticalAlignment="Center" />
                    <DropDownButton x:Name="DesktopIconButton" Grid.Column="1" MinWidth="132"
                                    HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="DesktopIconSummary" FontSize="12.5" />
                        <DropDownButton.Flyout>
                            <!-- 用 Flyout + CheckBox 而不是 MenuFlyout：勾选时菜单不关，可以连着点好几个 -->
                            <Flyout x:Name="DesktopIconFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel x:Name="DesktopIconPanel" Spacing="2" MinWidth="160" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="通知与多任务" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />

                <!-- 按 Alt+Tab 时显示应用中的标签页：开 = 3 个最新选项卡，关 = 不显示选项卡 -->
                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="按 Alt+Tab 显示标签页" FontSize="13.5" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="AltTabTabsToggle" Grid.Column="1"
                                  MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Toggled="AltTabTabs_Toggled" />
                </Grid>

                <!-- 应用运行通知：对应「用户账户控制设置」滑块，开 = 默认档（仅通知应用改动），关 = 最下面那档（全都不通知） -->
                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="关闭应用运行通知" FontSize="13.5" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="UacNotifyToggle" Grid.Column="1"
                                  MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Toggled="UacNotify_Toggled" />
                </Grid>

                <!-- 关闭请勿打扰：关掉主开关与投影 / 全屏 / 功能更新后一小时，只保留玩游戏时自动开启 -->
                <Grid ColumnSpacing="16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="关闭请勿打扰" FontSize="13.5" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="DisableDndToggle" Grid.Column="1"
                                  MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Toggled="DisableDnd_Toggled" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
