<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtkTools.Views.DiskHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct="using:ArtkTools.Services.ComputerTools"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">

    <Grid Padding="36,18,40,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <Button Padding="0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Left" Click="Back_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    <TextBlock Text="电脑工具" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>

            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="磁盘健康" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="读取每块硬盘的 SMART（温度、健康度、磨损）；程序启动时已获得管理员权限，ATA / NVMe 数据直接读取。只读检测，不会改动磁盘"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ProgressRing x:Name="DiskRing" Width="18" Height="18" IsActive="False" />
                    <Button x:Name="DiskElevatedButton" Content="以管理员身份读取"
                            Padding="12,6" Visibility="Collapsed"
                            Click="DiskElevated_Click" />
                    <Button x:Name="DiskRefreshButton" Content="重新检测"
                            Padding="12,6" Click="DiskRefresh_Click" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="DiskStatusText" Style="{StaticResource MetaStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" Padding="4">
                <ItemsControl x:Name="DiskList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ct:DiskHealthInfo">
                            <Border BorderBrush="{ThemeResource GridLineBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Padding="16,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Model}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DetailText}" Style="{StaticResource MetaStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind StatusText}" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind HealthText}" Style="{StaticResource MetaStyle}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind WearText}" Style="{StaticResource MetaStyle}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
