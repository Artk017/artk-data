<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtkTools.Views.WindowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ArtkTools.Views"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="16">
            <!-- ============ 页头 ============ -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Windows" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="系统信息与常用设置" Style="{StaticResource CaptionStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Padding="12,7" CornerRadius="6"
                            Click="FileLocations_Click"
                            ToolTipService.ToolTip="更改下载 / 文档 / 图片 / 视频的保存位置">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="文件位置" FontSize="12.5" />
                        </StackPanel>
                    </Button>

                    <Button Padding="12,7" CornerRadius="6"
                            Click="OpenPinyinVocab_Click"
                            ToolTipService.ToolTip="上传 / 导入微软拼音词汇">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE82D;" FontSize="13" />
                            <TextBlock Text="微软词汇" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ 系统信息条 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <local:SystemInfoView />
            </Border>

            <!-- ============ 系统设置 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <StackPanel Padding="20,14,20,12" Spacing="2">
                        <TextBlock Text="系统设置" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="开关即时生效，无需重启" Style="{StaticResource MetaStyle}" />
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource GridLineBrush}" />
                    <local:SystemSettingsView />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
