<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIDemo.Views.WindowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinUIDemo.Views"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="18">
            <!-- ============ 页头 ============ -->
            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="Windows" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="系统设置与硬件信息一览" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ 系统设置 ============ -->
                <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Padding="20,14,20,12" Spacing="2">
                            <TextBlock Text="系统设置" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="开关即时生效，无需重启" Style="{StaticResource MetaStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource GridLineBrush}" />
                        <local:SystemSettingsView />
                    </StackPanel>
                </Border>

                <!-- ============ 右侧：系统信息 + 快捷工具 ============ -->
                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Padding="20,14,20,12" Spacing="2">
                                <TextBlock Text="系统信息" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="设备名称、处理器、内存与显卡" Style="{StaticResource MetaStyle}" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource GridLineBrush}" />
                            <local:SystemInfoView />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <StackPanel Padding="20,14,20,12" Spacing="2">
                                <TextBlock Text="系统工具" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="文件位置与微软拼音词汇" Style="{StaticResource MetaStyle}" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource GridLineBrush}" />

                            <Grid Padding="16,14,16,16" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Style="{StaticResource TileButtonStyle}" Padding="14,12"
                                        HorizontalAlignment="Stretch"
                                        Click="FileLocations_Click"
                                        ToolTipService.ToolTip="更改下载 / 文档 / 图片 / 视频的保存位置">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="{ThemeResource IconTileBrush}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource BrandBrush}" />
                                        </Border>
                                        <TextBlock Text="文件位置" Style="{StaticResource SectionTitleStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Style="{StaticResource TileButtonStyle}" Padding="14,12"
                                        HorizontalAlignment="Stretch"
                                        Click="OpenPinyinVocab_Click"
                                        ToolTipService.ToolTip="上传 / 导入微软拼音词汇">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="{ThemeResource IconTileBrush}">
                                            <FontIcon Glyph="&#xE82D;" FontSize="12" Foreground="{ThemeResource BrandBrush}" />
                                        </Border>
                                        <TextBlock Text="微软词汇" Style="{StaticResource SectionTitleStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
