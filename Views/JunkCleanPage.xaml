<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtkTools.Views.JunkCleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:ArtkTools.Services"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">

    <Page.Resources>
        <!-- 左侧：一个分类 -->
        <DataTemplate x:Key="CategoryTemplate" x:DataType="svc:CleanerCategoryItem">
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                      Margin="10,3,10,0"
                      Padding="0">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Name}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind CountText}"
                                   Style="{StaticResource MetaStyle}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,4,0" />
                    </Grid>
                </Expander.Header>

                <ItemsControl ItemsSource="{x:Bind Entries}" Padding="2,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:CleanerEntryItem">
                            <Grid Padding="0,6" Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          MinWidth="0"
                                          MinHeight="0"
                                          Padding="0"
                                          BorderThickness="0"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          ToolTipService.ToolTip="{x:Bind Warning}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BA;"
                                                  FontSize="11"
                                                  Foreground="{ThemeResource WarningBrush}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind WarningVisibility, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Name}" />
                                    </StackPanel>
                                </CheckBox>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind SizeText, Mode=OneWay}"
                                           Visibility="{x:Bind SizeVisibility, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="6,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>

        <!-- 右侧：一条扫描结果 -->
        <DataTemplate x:Key="ResultTemplate" x:DataType="svc:ScanResultItem">
            <Grid Padding="4,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind AppName}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1"
                           Text="{x:Bind CountSummary}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,1,0,0" />

                <StackPanel Grid.RowSpan="2" Grid.Column="1"
                            Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Size}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource BrandBrush}"
                               VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE76C;" FontSize="10"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="ToolLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="18">
            <!-- ============ 页头 ============ -->
            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="垃圾清理" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="扫描并清理临时文件、应用缓存与浏览器残留" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <!-- ============ 清理概览（仪表图 + 关键数字 + 操作） ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="26,16,24,16">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 仪表图：已勾选清理项目 / 全部可清理项目 -->
                        <Grid Width="196" Height="120" VerticalAlignment="Center"
                              ToolTipService.ToolTip="已勾选清理项目的占比">
                            <Canvas Width="196" Height="120">
                                <Path Stroke="{ThemeResource GridLineBrush}" StrokeThickness="10">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="18,110" IsClosed="False">
                                                <ArcSegment Point="178,110" Size="80,80" SweepDirection="Clockwise" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <Path x:Name="GaugeValueArc"
                                      Stroke="{ThemeResource BrandBrush}" StrokeThickness="10"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Spacing="0" Margin="0,0,0,3">
                                <TextBlock x:Name="GaugePercentText" Text="0%"
                                           FontSize="22" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource BrandBrush}" />
                                <TextBlock x:Name="GaugeSubText" Text="已选 0 / 0 项"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- 关键数字 -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="本次可清理" Style="{StaticResource CaptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="TotalSizeText" Text="0 B" Style="{StaticResource StatValueStyle}" />
                                <TextBlock x:Name="TotalMetaText" Text="" Style="{StaticResource MetaStyle}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </StackPanel>
                            <TextBlock x:Name="StatusText" Text="正在加载清理规则…"
                                       Style="{StaticResource MetaStyle}" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>

                        <!-- 操作 -->
                        <StackPanel Grid.Column="2" Spacing="8" Width="136" VerticalAlignment="Center">
                            <Button x:Name="ScanButton" Content="开始扫描"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="Scan_Click" />
                            <Button x:Name="CleanButton" Content="执行清理"
                                    IsEnabled="False"
                                    HorizontalAlignment="Stretch"
                                    Click="Clean_Click" />
                            <Button x:Name="CancelButton" Content="取消"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Stretch"
                                    Click="Cancel_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="ScanProgressBar" Height="5" Maximum="100" Value="0"
                                     VerticalAlignment="Center"
                                     Foreground="{ThemeResource BrandBrush}" />
                        <TextBlock x:Name="ProgressText" Grid.Column="1" Text=""
                                   Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 清理主体 ============ -->
            <Grid ColumnSpacing="14" Height="580">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：清理项目 -->
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Padding="18,14,18,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="清理项目" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectionSummaryText" Grid.Column="1" Text=""
                                       Style="{StaticResource MetaStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBox x:Name="SearchBox" Grid.Row="1"
                                 Margin="18,0,18,6"
                                 PlaceholderText="搜索应用或清理项目"
                                 TextChanged="SearchBox_TextChanged" />

                        <StackPanel x:Name="SelectionToolbar" Grid.Row="2" Orientation="Horizontal" Spacing="2" Margin="14,0,14,4">
                            <Button Content="全选" Style="{StaticResource ToolLinkButtonStyle}" Click="SelectAll_Click" />
                            <Button Content="全不选" Style="{StaticResource ToolLinkButtonStyle}" Click="SelectNone_Click" />
                            <Button Content="恢复默认" Style="{StaticResource ToolLinkButtonStyle}" Click="SelectDefaults_Click" />
                            <Button Content="全部展开" Style="{StaticResource ToolLinkButtonStyle}" Click="ExpandAll_Click" />
                            <Button Content="全部折叠" Style="{StaticResource ToolLinkButtonStyle}" Click="CollapseAll_Click" />
                        </StackPanel>

                        <Border Grid.Row="2" Height="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Background="{ThemeResource GridLineBrush}" />

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,4,0,8">
                            <ItemsControl x:Name="CategoriesList" ItemTemplate="{StaticResource CategoryTemplate}" />
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyCategoriesText" Grid.Row="3"
                                   Text="正在识别本机已安装的应用…"
                                   Style="{StaticResource MetaStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="24" />

                        <!-- 勾选同步到服务器 -->
                        <Border Grid.Row="4" Padding="14,10,14,12"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{ThemeResource GridLineBrush}">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="勾选自动保存在本机，点右侧可同步到服务器"
                                               Style="{StaticResource MetaStyle}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="SaveSettingsButton" Grid.Column="1"
                                            Click="SaveSettings_Click"
                                            ToolTipService.ToolTip="把当前勾选的清理项目保存到服务器">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ProgressRing x:Name="SaveSettingsRing" Width="14" Height="14"
                                                          IsActive="False" Visibility="Collapsed" />
                                            <FontIcon Glyph="&#xE74E;" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="保存设置" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="SaveSettingsHintText" Text="尚未同步到服务器"
                                           Style="{StaticResource MetaStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧：扫描结果 -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="18,14,18,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="扫描结果" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="点击项目可查看将删除的文件与注册表项"
                                           Style="{StaticResource MetaStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ResultTotalText" Grid.Column="1" Text=""
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BrandBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                Background="{ThemeResource GridLineBrush}" />

                        <Grid Grid.Row="1">
                            <ListView x:Name="ResultsList"
                                      ItemTemplate="{StaticResource ResultTemplate}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="ResultsList_ItemClick"
                                      Padding="10,4,10,8">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>

                            <StackPanel x:Name="EmptyResultsPanel"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" Margin="24">
                                <FontIcon Glyph="&#xE8A5;" FontSize="30"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="EmptyResultsText"
                                           Text="点击「开始扫描」查看可清理的文件"
                                           Style="{StaticResource MetaStyle}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="清理规则来自 Winapp2.ini 与国产软件补充规则 · CC-BY-SA-4.0 · 由 Winapp2 项目与 builtbybel 维护"
                       Style="{StaticResource MetaStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
