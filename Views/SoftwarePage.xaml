<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtkTools.Views.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArtkTools.Views"
    Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="36,18,40,32">
        <StackPanel Spacing="16" MaxWidth="1180" HorizontalAlignment="Left">
            <!-- ============ 页头 ============ -->
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="软件" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="在网页里点厂商的下载按钮，就能一键抓取直链并添加" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Grid>

                <!-- 第二行：清单来源 + 操作按钮 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="SourceText" Text="清单加载中…" Style="{StaticResource MetaStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="添加软件" CornerRadius="8" Padding="14,5,14,5" Click="Add_Click"
                                ToolTipService.ToolTip="打开网页，点厂商的下载按钮即可一键抓取直链并添加"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ 软件卡片 ============ -->
            <ItemsRepeater x:Name="Repeater" ItemsSource="{x:Bind Items}" UseLayoutRounding="True">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="330" MinItemHeight="0"
                                       MinRowSpacing="14" MinColumnSpacing="14"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:SoftwareItem">
                        <!-- 圆角用 Rectangle 画：Border 的 CornerRadius 是硬裁剪，125% 缩放下边缘会有台阶 -->
                        <Grid VerticalAlignment="Stretch" RightTapped="Card_RightTapped"
                              RenderTransformOrigin="0.5,0.5"
                              PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                              PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Rectangle RadiusX="14" RadiusY="14"
                                       Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                       Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                       StrokeThickness="1" />

                            <Grid Padding="16" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 图标 + 名称 -->
                                <Grid ColumnSpacing="11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="40" Height="40">
                                        <Rectangle RadiusX="11" RadiusY="11" Fill="{x:Bind TileBrush}"
                                                   Visibility="{x:Bind TileVisibility, Mode=OneWay}" />
                                        <Rectangle RadiusX="11" RadiusY="11" Fill="{x:Bind IconBrush, Mode=OneWay}"
                                                   Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Initial}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="White" Visibility="{x:Bind InitialVisibility, Mode=OneWay}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="14.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <!-- 编辑 / 删除入口（右键也行，但这个更好发现） -->
                                    <Button Grid.Column="2" Tag="{x:Bind}" Click="More_Click"
                                            Width="28" Height="28" Padding="0" MinWidth="0" MinHeight="0"
                                            CornerRadius="8" Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Top"
                                            ToolTipService.ToolTip="编辑 / 删除">
                                        <FontIcon Glyph="&#xE712;" FontSize="13"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </Grid>

                                <!-- 状态：占住剩余高度，进度条出现时卡片不会跳 -->
                                <TextBlock Grid.Row="1" Text="{x:Bind StatusText, Mode=OneWay}"
                                           Style="{StaticResource MetaStyle}" MinHeight="17"
                                           VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />

                                <ProgressBar Grid.Row="2" Height="3" Minimum="0" Maximum="100"
                                             Value="{x:Bind Progress, Mode=OneWay}"
                                             Opacity="{x:Bind ProgressOpacity, Mode=OneWay}" />

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right">
                                    <Button Content="官网" CornerRadius="8" Padding="12,5,12,5"
                                            Visibility="{x:Bind HomeVisibility}"
                                            Tag="{x:Bind HomeUrl}" Click="Home_Click" />
                                    <Button Content="打开文件夹" CornerRadius="8" Padding="12,5,12,5"
                                            Visibility="{x:Bind FolderVisibility, Mode=OneWay}"
                                            Tag="{x:Bind}" Click="ItemFolder_Click" />
                                    <Button Content="{x:Bind PrimaryText, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            CornerRadius="8" Padding="16,5,16,5"
                                            Tag="{x:Bind}" Click="Primary_Click" />

                                    <Button Width="24" Height="30" Padding="0" MinWidth="0" MinHeight="0"
                                            CornerRadius="6" Background="Transparent" BorderThickness="0"
                                            Margin="-5,0,0,0" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="更多安装方式">
                                        <FontIcon Glyph="&#xE70D;" FontSize="10"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem Text="非静默安装"
                                                                Tag="{x:Bind}" Click="ManualInstall_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8EA;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- 从服务器拿不到清单时：列表空着，这里给一句原因 + 重试 -->
            <Border x:Name="EmptyState" Visibility="Collapsed" Style="{StaticResource CardStyle}"
                    Padding="24,22" Margin="0,4,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="没有拿到软件清单" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource MetaStyle}" TextWrapping="Wrap" />
                    <Button Content="重试" CornerRadius="8" Padding="16,5,16,5" HorizontalAlignment="Left"
                            Click="Retry_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
