<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtkTools.Views.RuntimeRepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct="using:ArtkTools.Services.ComputerTools"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">

    <Grid Padding="36,18,40,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <Button Style="{StaticResource BackPillButtonStyle}" Click="Back_Click"
                    ToolTipService.ToolTip="返回电脑工具">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Width="22" Height="22" CornerRadius="6"
                            Background="{ThemeResource IconTileBrush}">
                        <FontIcon Glyph="&#xE72B;" FontSize="11"
                                  Foreground="{ThemeResource BrandBrush}" />
                    </Border>
                    <TextBlock Text="电脑工具" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>

            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="运行库修复" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="检测并补全 VC++ 运行库、.NET Framework 与 DirectX 旧版 DLL"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ProgressRing x:Name="RuntimeRing" Width="18" Height="18" IsActive="False" />
                    <Button x:Name="RuntimeRefreshButton" Content="重新检测"
                            Padding="12,6" Click="RuntimeRefresh_Click" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="RuntimeStatusText" Style="{StaticResource MetaStyle}" TextWrapping="Wrap" />
            <StackPanel x:Name="RuntimeProgressPanel" Visibility="Collapsed" Spacing="4">
                <ProgressBar x:Name="RuntimeProgress" Height="4" />
                <TextBlock x:Name="RuntimeProgressText" Style="{StaticResource MetaStyle}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" Padding="4">
                <ItemsControl x:Name="RuntimeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ct:RuntimeStatus">
                            <Border BorderBrush="{ThemeResource GridLineBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Padding="16,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource MetaStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind StateText}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <Button Grid.Column="2" Content="修复" Padding="14,6"
                                            Click="RuntimeRepair_Click"
                                            IsEnabled="{x:Bind NeedsRepair}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
